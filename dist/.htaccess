<IfModule mod_rewrite.c>
  RewriteEngine On

  # Full Circle's installed app and shared links use the apex host. Redirect
  # the legacy www host before the SPA fallback so both old shortcuts and
  # browser bookmarks converge on one origin.
  RewriteCond %{HTTP_HOST} ^www\.fullcircle\.partnertai\.com$ [NC]
  RewriteRule ^ https://fullcircle.partnertai.com%{REQUEST_URI} [R=308,L,NE]

  # An old shortcut or notification must never display a bundle as a text
  # document. Script/style subrequests still pass through normally.
  RewriteCond %{REQUEST_URI} ^/assets/.*\.(?:js|mjs|css|json|map)$ [NC]
  RewriteCond %{HTTP:Sec-Fetch-Dest} =document [OR]
  RewriteCond %{HTTP:Accept} text/html [NC]
  RewriteRule ^ /?fc-asset-recovery=168 [R=302,L,NE]

  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(?!(?:sw|fc-worker)\.js$).*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # These files control which application release starts. Keep this block
  # after the general JS/CSS rule; both worker paths are excluded above.
  <FilesMatch "^(index\.html|sw\.js|fc-worker\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
  </Files>

  <Files "fc-worker.js">
    Header set Service-Worker-Allowed "/"
  </Files>

  <Files "index.html">
    Header set Content-Type "text/html; charset=UTF-8"
    Header set X-Content-Type-Options "nosniff"
  </Files>
</IfModule>
